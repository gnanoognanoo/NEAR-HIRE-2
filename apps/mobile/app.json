{
  "expo": {
    "name": "NearHire",
    "slug": "nearhire",
    "owner": "gnanoos-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nearhire.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "nearhire",
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NearHire uses your location to show nearby jobs and workers."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "9788df17-3b02-4cd3-b594-8daff14abcad"
      }
    }
  }
}
