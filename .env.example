# Copy public values into apps/mobile/.env and admin values into apps/admin/.env.local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DEMO_MODE=false
# Optional self-hosted override; leave empty for OpenFreeMap.
EXPO_PUBLIC_BASEMAP_STYLE_URL=
EXPO_PUBLIC_BASEMAP_ATTRIBUTION=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Edge Function secrets ONLY. Never prefix these with EXPO_PUBLIC or NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
OLA_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OUTBOX_SECRET=
ADMIN_APP_URL=http://localhost:3000
MOBILE_APP_SCHEME=nearhire

# Hosted Edge provider selection; mock adapter is test-only.
LOCATION_PROVIDER=ola
# Path to Firebase Android config, not a service-account private key.
GOOGLE_SERVICES_JSON=
# Existing EAS project id, when supplied via environment.
EAS_PROJECT_ID=
